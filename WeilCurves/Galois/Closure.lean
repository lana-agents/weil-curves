/-!
# A Galois cover with a rational place, and the lower bound for `N_r`

Nivedita (*Riemann hypothesis for function fields*, CMI 2009), §3.2.4 ("the right constant field
extension") and Kedlaya (*Weil cohomology* notes), proof of Lemma 5.1.9. We construct, for a
function field `F` over a finite field `k` with full constant field:

* a separating element `x` (`F / k(x)` separable; Mathlib,
  `exists_isTranscendenceBasis_and_isSeparable_of_perfectField`) and a primitive element `y`
  of `F / k(x)` with minimal polynomial `P`;
* `M₁` = the splitting field of `P` over `F`, `k₁` its full constant field (the algebraic
  closure of `k` in `M₁`), `β₀` a place of `M₁` of degree `D` over `k₁`;
* `M = ConstExt k₁ M₁ D`, a function field over `k' = BaseExt k₁ D` with full constant field `k'`
  and a place of degree one over `k'` (above `β₀`, `places_above_of_dvd`). `M` is Galois over
  `F` (splitting field of `P · minpoly_k θ`, `θ` a primitive element of `k' / k`) and over
  `k'(x)` (splitting field of `P`).

Deviation from Nivedita: we do not make `M` geometric over `k(x)`; instead the counting
(`pointCount_ge_of_galois`) is done over `k'(x)` and restricted to `F` (no comparison between
`N_r(F)` and point counts of `F k'`).

## Main result

* `WeilCurves.FunctionField.exists_lower_bound`: there are `d ≥ 1` and constants `A`, `C`, `G₀`
  with `N_{dm}(F) ≥ q^{dm} − A q^{dm/2} − C` whenever `q^{dm} = p^{2b} > G₀`.
-/

open Polynomial IntermediateField
open scoped IntermediateField

namespace WeilCurves.FunctionField

open Divisor Place

/-! ### Function fields over an algebraic extension of the base -/

section Tower

variable {k k' M : Type*} [Field k] [Field k'] [Field M] [Algebra k k'] [Algebra k' M]
  [Algebra k M] [IsScalarTower k k' M]

/-- A function field over `k` is a function field over every algebraic extension `k' ⊆ M` of
`k`. -/
theorem IsFunctionField.of_algebraic_base [Algebra.IsAlgebraic k k'] [IsFunctionField k M] :
    IsFunctionField k' M := by
  obtain ⟨t, ht⟩ := exists_transcendental k M
  have htr : Transcendental k' t := fun h ↦ ht (h.restrictScalars k)
  refine ⟨⟨t, htr, ?_⟩⟩
  have : FiniteDimensional k⟮t⟯ M := finiteDimensional_adjoin ht
  have hle : k⟮t⟯ ≤ (IntermediateField.adjoin k' {t}).restrictScalars k := by
    rw [IntermediateField.adjoin_simple_le_iff]
    exact IntermediateField.mem_adjoin_simple_self _ t
  obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := k⟮t⟯) (M := M)
  refine ⟨⟨S, eq_top_iff.mpr fun x hxt ↦ ?_⟩⟩
  clear hxt
  have hx : x ∈ Submodule.span k⟮t⟯ (S : Set M) := by rw [hS]; trivial
  induction hx using Submodule.span_induction with
  | mem y hy => exact Submodule.subset_span hy
  | zero => exact zero_mem _
  | add y z _ _ hy hz => exact add_mem hy hz
  | smul c y _ hy =>
    have : c • y = (⟨(c : M), hle c.2⟩ : IntermediateField.adjoin k' {t}) • y := rfl
    rw [this]
    exact Submodule.smul_mem _ _ hy

end Tower

/-! ### A criterion for Galois extensions -/

section GaloisCrit

variable {L₀ M : Type*} [Field L₀] [Field M] [Algebra L₀ M]

/-- `M / L₀` is Galois if it is generated by the roots of a polynomial which splits in `M` and
whose roots are separable. -/
theorem isGalois_of_adjoin_rootSet (f : L₀[X]) (hspl : (f.map (algebraMap L₀ M)).Splits)
    (hsep : ∀ a ∈ f.rootSet M, IsSeparable L₀ a)
    (hgen : IntermediateField.adjoin L₀ (f.rootSet M) = ⊤) : IsGalois L₀ M := by
  have hsf : IsSplittingField L₀ M f :=
    isSplittingField_iff_intermediateField.mpr ⟨hspl, hgen⟩
  have hn : Normal L₀ M := Normal.of_isSplittingField f
  have hs : Algebra.IsSeparable L₀ M := by
    rw [← IntermediateField.isSeparable_top, ← hgen,
      IntermediateField.isSeparable_adjoin_iff_isSeparable]
    exact hsep
  exact isGalois_iff.mpr ⟨hs, hn⟩

end GaloisCrit

/-! ### Generation lemmas -/

section Generation

variable {F M₁ M : Type*} [Field F] [Field M₁] [Field M] [Algebra F M₁] [Algebra M₁ M]
  [Algebra F M] [IsScalarTower F M₁ M]

/-- If a subring `S` of `M = M₁[τ]` contains `F`, the images of the generators of `M₁ / F` and `τ`,
it is everything. -/
theorem subring_eq_top_of_gen (PF : F[X]) (S : Subring M)
    (hgen₁ : Algebra.adjoin F (PF.rootSet M₁) = ⊤) {τ : M}
    (hgen : Algebra.adjoin M₁ ({τ} : Set M) = ⊤) (hF : ∀ f : F, algebraMap F M f ∈ S)
    (hroots : ∀ r ∈ PF.rootSet M₁, algebraMap M₁ M r ∈ S) (hτ : τ ∈ S) : S = ⊤ := by
  have hM₁ : ∀ m : M₁, algebraMap M₁ M m ∈ S := by
    intro m
    have hm : m ∈ Algebra.adjoin F (PF.rootSet M₁) := by rw [hgen₁]; trivial
    induction hm using Algebra.adjoin_induction with
    | mem r hr => exact hroots r hr
    | algebraMap c =>
      rw [← IsScalarTower.algebraMap_apply]; exact hF c
    | add a b _ _ ha hb => rw [map_add]; exact S.add_mem ha hb
    | mul a b _ _ ha hb => rw [map_mul]; exact S.mul_mem ha hb
  refine eq_top_iff.mpr fun m hmtop ↦ ?_
  clear hmtop
  have hm : m ∈ Algebra.adjoin M₁ ({τ} : Set M) := by rw [hgen]; trivial
  induction hm using Algebra.adjoin_induction with
  | mem r hr => rw [Set.mem_singleton_iff.mp hr]; exact hτ
  | algebraMap c => exact hM₁ c
  | add a b _ _ ha hb => exact S.add_mem ha hb
  | mul a b _ _ ha hb => exact S.mul_mem ha hb

end Generation

/-! ### The construction -/

section Construction

variable {k F : Type*} [Field k] [Finite k] [Field F] [Algebra k F] [IsFunctionField k F]

/-- A separating transcendental element: `F / k(x)` is separable. -/
theorem exists_separating (k F : Type*) [Field k] [Finite k] [Field F] [Algebra k F]
    [IsFunctionField k F] : ∃ x : F, Transcendental k x ∧ Algebra.IsSeparable k⟮x⟯ F := by
  have : Algebra.EssFiniteType k F := by
    obtain ⟨S, hS⟩ := exists_finset_adjoin_eq_top k F
    exact IntermediateField.fg_top_iff.mp ⟨S, hS⟩
  obtain ⟨s, hs, hsep⟩ := exists_isTranscendenceBasis_and_isSeparable_of_perfectField k F
  have hcard : s.card = 1 := by
    have h := hs.lift_cardinalMk_eq_trdeg
    rw [trdeg_eq_one k F] at h
    simpa using h
  obtain ⟨x, rfl⟩ := Finset.card_eq_one.mp hcard
  refine ⟨x, ?_, ?_⟩
  · exact hs.1.transcendental ⟨x, Finset.mem_singleton_self x⟩
  · have h : ((({x} : Finset F) : Set F)) = {x} := Finset.coe_singleton x
    rw [h] at hsep
    exact hsep

set_option maxHeartbeats 4000000 in
-- the construction carries many instances
/-- The lower bound from a splitting field `M₁` of `P` over `F`. -/
theorem exists_lower_bound_of_splitting (p : ℕ) [Fact p.Prime]
    [CharP k p] (x : F) (hx : Transcendental k x) [Algebra.IsSeparable k⟮x⟯ F] (y : F)
    (hy : k⟮x⟯⟮y⟯ = ⊤) (M₁ : Type*) [Field M₁] [Algebra F M₁] [Algebra k M₁]
    [IsScalarTower k F M₁] [FiniteDimensional F M₁]
    (hspl : (((minpoly k⟮x⟯ y).map (algebraMap k⟮x⟯ F)).map (algebraMap F M₁)).Splits)
    (hgen₁ : Algebra.adjoin F (((minpoly k⟮x⟯ y).map (algebraMap k⟮x⟯ F)).rootSet M₁) = ⊤) :
    ∃ d : ℕ, 0 < d ∧ ∃ A C G₀ : ℤ, ∀ m b : ℕ, Nat.card k ^ (d * m) = p ^ (2 * b) →
      G₀ < (p : ℤ) ^ (2 * b) → (p : ℤ) ^ (2 * b) - A * p ^ b - C ≤ pointCount k F (d * m) := by
  classical
  set P := minpoly k⟮x⟯ y with hPdef
  set PF := P.map (algebraMap k⟮x⟯ F) with hPFdef
  have hyint : IsIntegral k⟮x⟯ y := Algebra.IsIntegral.isIntegral y
  have hPsep : P.Separable := Algebra.IsSeparable.isSeparable k⟮x⟯ y
  have hPFsep : PF.Separable := hPsep.map
  have hPF0 : PF ≠ 0 := Polynomial.map_ne_zero (minpoly.ne_zero hyint)
  have : IsFunctionField k M₁ := IsFunctionField.of_finite (K := F)
  -- the constant field `k₁` of `M₁`
  set k₁ := algebraicClosure k M₁ with hk₁def
  have : FiniteDimensional k (integralClosure k M₁) := by
    have h := finiteDimensional_L (k := k) (K := M₁) 0
    rw [L_zero] at h
    exact h
  have : FiniteDimensional k k₁ := inferInstanceAs (FiniteDimensional k (integralClosure k M₁))
  have : Finite k₁ := Module.finite_of_finite k
  have : Algebra.IsAlgebraic k k₁ := Algebra.IsAlgebraic.of_finite k k₁
  have : IsFunctionField k₁ M₁ := IsFunctionField.of_algebraic_base (k := k)
  have hk₁ : IsFullConstantField k₁ M₁ := fun f hf ↦
    ⟨⟨f, mem_algebraicClosure_iff.mpr (hf.restrictScalars k)⟩, rfl⟩
  have : Fact (IsFullConstantField k₁ M₁) := ⟨hk₁⟩
  -- a place of `M₁` and the constant field extension
  obtain ⟨β₀⟩ : Nonempty (Place k₁ M₁) := inferInstance
  set D := β₀.deg with hD
  have : NeZero D := ⟨β₀.deg_pos.ne'⟩
  letI : Algebra k (BaseExt k₁ D) :=
    ((algebraMap k₁ (BaseExt k₁ D)).comp (algebraMap k k₁)).toAlgebra
  have : IsScalarTower k k₁ (BaseExt k₁ D) := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower k (BaseExt k₁ D) (ConstExt k₁ M₁ D) := by
    refine IsScalarTower.of_algebraMap_eq fun c ↦ ?_
    change _ = baseLift D (algebraMap k₁ (BaseExt k₁ D) (algebraMap k k₁ c))
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply k M₁ (ConstExt k₁ M₁ D),
      IsScalarTower.algebraMap_apply k k₁ M₁,
      ← IsScalarTower.algebraMap_apply k₁ M₁ (ConstExt k₁ M₁ D)]
    rfl
  have : FiniteDimensional F (ConstExt k₁ M₁ D) := FiniteDimensional.trans F M₁ _
  have : IsFunctionField k (ConstExt k₁ M₁ D) := IsFunctionField.of_finite (K := F)
  have hkM : IsFullConstantField (BaseExt k₁ D) (ConstExt k₁ M₁ D) :=
    isFullConstantField_constExt D
  have : CharP (BaseExt k₁ D) p :=
    charP_of_injective_algebraMap (algebraMap k (BaseExt k₁ D)).injective p
  -- a rational place
  obtain ⟨α, hα⟩ : ∃ α : Place (BaseExt k₁ D) (ConstExt k₁ M₁ D), α.deg = 1 := by
    obtain ⟨h1, h2⟩ := places_above_of_dvd D β₀ dvd_rfl
    have hne : {Q : Place k₁ (ConstExt k₁ M₁ D) | Q.restrict (K := M₁) = β₀}.Nonempty :=
      Set.nonempty_of_ncard_ne_zero fun h0 ↦ β₀.deg_pos.ne' (h1.symm.trans h0)
    obtain ⟨Q, hQ⟩ := hne
    refine ⟨Q.toKr D, ?_⟩
    have := deg_eq_mul_deg_toKr D Q
    rw [h2 Q hQ] at this
    have hD0 : 0 < D := β₀.deg_pos
    have : D * 1 = D * (Q.toKr D).deg := by rw [mul_one]; exact this
    exact (Nat.eq_of_mul_eq_mul_left hD0 this).symm
  -- the transcendental element
  set xM := algebraMap F (ConstExt k₁ M₁ D) x with hxM
  have hxMk : Transcendental k xM :=
    (transcendental_algebraMap_iff (algebraMap F (ConstExt k₁ M₁ D)).injective).mpr hx
  have : Algebra.IsAlgebraic k (BaseExt k₁ D) := Algebra.IsAlgebraic.of_finite _ _
  have : Fact (Transcendental (BaseExt k₁ D) xM) := ⟨fun h ↦ hxMk (h.restrictScalars k)⟩
  -- generation data
  set τ : ConstExt k₁ M₁ D := theta D
  have hτgen : Algebra.adjoin M₁ ({τ} : Set (ConstExt k₁ M₁ D)) = ⊤ :=
    AdjoinRoot.adjoinRoot_eq_top
  have hτk' : τ = algebraMap (BaseExt k₁ D) (ConstExt k₁ M₁ D) (basePB k₁ D).gen := by
    rw [algebraMap_baseExt, baseLift_gen]
  have hroots : ∀ r ∈ PF.rootSet M₁, algebraMap M₁ (ConstExt k₁ M₁ D) r ∈
      PF.rootSet (ConstExt k₁ M₁ D) := by
    intro r hr
    rw [Polynomial.mem_rootSet] at hr ⊢
    refine ⟨hPF0, ?_⟩
    rw [aeval_algebraMap_apply, hr.2, map_zero]
  have hsplM : (PF.map (algebraMap F (ConstExt k₁ M₁ D))).Splits := by
    rw [IsScalarTower.algebraMap_eq F M₁ (ConstExt k₁ M₁ D), ← Polynomial.map_map]
    exact hspl.map _
  -- `M` is Galois over `F`
  obtain ⟨θ, hθ⟩ := Field.exists_primitive_element k (BaseExt k₁ D)
  have hθint : IsIntegral k θ := Algebra.IsIntegral.isIntegral θ
  set g := (minpoly k θ).map (algebraMap k F) with hgdef
  have hg0 : g ≠ 0 := Polynomial.map_ne_zero (minpoly.ne_zero hθint)
  have hgsep : g.Separable := Polynomial.Separable.map (Algebra.IsSeparable.isSeparable k θ)
  set θM := algebraMap (BaseExt k₁ D) (ConstExt k₁ M₁ D) θ
  have hθroot : θM ∈ g.rootSet (ConstExt k₁ M₁ D) := by
    rw [Polynomial.mem_rootSet]
    refine ⟨hg0, ?_⟩
    rw [hgdef, aeval_map_algebraMap]
    change aeval (algebraMap (BaseExt k₁ D) (ConstExt k₁ M₁ D) θ) (minpoly k θ) = 0
    rw [aeval_algebraMap_apply, minpoly.aeval, map_zero]
  have hgspl : (g.map (algebraMap F (ConstExt k₁ M₁ D))).Splits := by
    rw [hgdef, Polynomial.map_map, ← IsScalarTower.algebraMap_eq,
      IsScalarTower.algebraMap_eq k (BaseExt k₁ D) (ConstExt k₁ M₁ D), ← Polynomial.map_map]
    exact (Normal.splits (inferInstance : Normal k (BaseExt k₁ D)) θ).map _
  have hpolyθ : ∀ c : BaseExt k₁ D, ∃ q : k[X], aeval θ q = c := by
    intro c
    have hc : c ∈ (k⟮θ⟯).toSubalgebra := by rw [hθ]; trivial
    rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hθint.isAlgebraic,
      Algebra.adjoin_singleton_eq_range_aeval] at hc
    obtain ⟨q, hq⟩ := hc
    exact ⟨q, hq⟩
  have hGalF : IsGalois F (ConstExt k₁ M₁ D) := by
    refine isGalois_of_adjoin_rootSet (PF * g) ?_ ?_ ?_
    · rw [Polynomial.map_mul]; exact hsplM.mul hgspl
    · intro a ha
      rw [Polynomial.mem_rootSet, map_mul, mul_eq_zero] at ha
      rcases ha.2 with h | h
      · exact hPFsep.of_dvd (minpoly.dvd F a h)
      · exact hgsep.of_dvd (minpoly.dvd F a h)
    · set E := IntermediateField.adjoin F ((PF * g).rootSet (ConstExt k₁ M₁ D))
      have hsub : ∀ r, r ∈ PF.rootSet (ConstExt k₁ M₁ D) ∨ r ∈ g.rootSet (ConstExt k₁ M₁ D) →
          r ∈ E := by
        intro r hr
        apply IntermediateField.subset_adjoin
        simp only [Polynomial.mem_rootSet] at hr ⊢
        refine ⟨mul_ne_zero hPF0 hg0, ?_⟩
        rw [map_mul]
        rcases hr with h | h
        · rw [h.2, zero_mul]
        · rw [h.2, mul_zero]
      have hθE : θM ∈ E := hsub θM (Or.inr hθroot)
      have hk'E : ∀ c : BaseExt k₁ D, algebraMap (BaseExt k₁ D) (ConstExt k₁ M₁ D) c ∈ E := by
        intro c
        obtain ⟨q, rfl⟩ := hpolyθ c
        rw [← aeval_algebraMap_apply]
        induction q using Polynomial.induction_on with
        | C a =>
          rw [aeval_C, IsScalarTower.algebraMap_apply k F]
          exact E.algebraMap_mem _
        | add q₁ q₂ h₁ h₂ => rw [map_add]; exact E.add_mem h₁ h₂
        | monomial n a _ =>
          rw [map_mul, map_pow, aeval_C, aeval_X]
          refine E.mul_mem ?_ (pow_mem hθE (n + 1))
          rw [IsScalarTower.algebraMap_apply k F]
          exact E.algebraMap_mem _
      have := subring_eq_top_of_gen PF E.toSubalgebra.toSubring hgen₁ hτgen
        (fun f ↦ E.algebraMap_mem f) (fun r hr ↦ hsub _ (Or.inl (hroots r hr)))
        (by rw [hτk']; exact hk'E _)
      exact IntermediateField.toSubalgebra_injective
        (Subalgebra.toSubring_injective (this.trans (by simp)))
  -- `M` is Galois over `k'(x)`
  set L₀ := (BaseExt k₁ D)⟮xM⟯ with hL₀
  have hle : k⟮xM⟯ ≤ L₀.restrictScalars k := by
    rw [IntermediateField.adjoin_simple_le_iff]
    exact IntermediateField.mem_adjoin_simple_self _ xM
  let ι : k⟮x⟯ →+* L₀ :=
    (IntermediateField.inclusion hle).toRingHom.comp
      (adjoinMapEquiv (L := ConstExt k₁ M₁ D) x).toRingEquiv.toRingHom
  have hι : ∀ c : k⟮x⟯, algebraMap L₀ (ConstExt k₁ M₁ D) (ι c) =
      algebraMap F (ConstExt k₁ M₁ D) (c : F) := by
    intro c
    exact coe_adjoinMapEquiv x c
  set P₀ := P.map ι
  have hP₀map : P₀.map (algebraMap L₀ (ConstExt k₁ M₁ D)) =
      PF.map (algebraMap F (ConstExt k₁ M₁ D)) := by
    rw [Polynomial.map_map, Polynomial.map_map]
    congr 1
  have hP₀0 : P₀ ≠ 0 := Polynomial.map_ne_zero (minpoly.ne_zero hyint)
  have hrootsP₀ : P₀.rootSet (ConstExt k₁ M₁ D) = PF.rootSet (ConstExt k₁ M₁ D) := by
    rw [Polynomial.rootSet_def, Polynomial.rootSet_def, Polynomial.aroots_def,
      Polynomial.aroots_def, hP₀map]
  have hGalL : IsGalois L₀ (ConstExt k₁ M₁ D) := by
    refine isGalois_of_adjoin_rootSet P₀ (by rw [hP₀map]; exact hsplM) ?_ ?_
    · intro a ha
      have hP₀sep : P₀.Separable := hPsep.map
      exact hP₀sep.of_dvd (minpoly.dvd L₀ a (Polynomial.aeval_eq_zero_of_mem_rootSet ha))
    · set E := IntermediateField.adjoin L₀ (P₀.rootSet (ConstExt k₁ M₁ D))
      have hyE : algebraMap F (ConstExt k₁ M₁ D) y ∈ E := by
        apply IntermediateField.subset_adjoin
        rw [hrootsP₀, Polynomial.mem_rootSet]
        refine ⟨hPF0, ?_⟩
        rw [aeval_algebraMap_apply, hPFdef, aeval_map_algebraMap, minpoly.aeval, map_zero]
      have hcE : ∀ a : k⟮x⟯, algebraMap F (ConstExt k₁ M₁ D) (a : F) ∈ E := by
        intro a
        rw [← hι]
        exact E.algebraMap_mem _
      have hFE : ∀ f : F, algebraMap F (ConstExt k₁ M₁ D) f ∈ E := by
        intro f
        have hf : f ∈ (k⟮x⟯⟮y⟯).toSubalgebra := by rw [hy]; trivial
        rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hyint.isAlgebraic,
          Algebra.adjoin_singleton_eq_range_aeval] at hf
        obtain ⟨q, rfl⟩ := hf
        change algebraMap F (ConstExt k₁ M₁ D) (aeval y q) ∈ E
        induction q using Polynomial.induction_on with
        | C a =>
          rw [aeval_C]
          exact hcE a
        | add q₁ q₂ h₁ h₂ => rw [map_add, map_add]; exact E.add_mem h₁ h₂
        | monomial n a _ =>
          rw [map_mul, map_pow, aeval_C, aeval_X, map_mul, map_pow]
          exact E.mul_mem (hcE a) (pow_mem hyE (n + 1))
      have := subring_eq_top_of_gen PF E.toSubalgebra.toSubring hgen₁ hτgen hFE
        (fun r hr ↦ IntermediateField.subset_adjoin _ _ (by rw [hrootsP₀]; exact hroots r hr))
        (by
          rw [hτk']
          have : algebraMap (BaseExt k₁ D) (ConstExt k₁ M₁ D) (basePB k₁ D).gen ∈ L₀ :=
            IntermediateField.algebraMap_mem _ _
          exact E.algebraMap_mem ⟨_, this⟩)
      exact IntermediateField.toSubalgebra_injective
        (Subalgebra.toSubring_injective (this.trans (by simp)))
  -- the counting theorem
  obtain ⟨C, hC⟩ := pointCount_ge_of_galois (k := k) (F := F) (k' := BaseExt k₁ D)
    (M := ConstExt k₁ M₁ D) hkM x α hα p
  set NG := (Nat.card Gal((ConstExt k₁ M₁ D)/L₀) : ℤ)
  set gM := genus (BaseExt k₁ D) (ConstExt k₁ M₁ D)
  refine ⟨Module.finrank k (BaseExt k₁ D), Module.finrank_pos, (NG - 1) * (2 * gM + 1),
    (NG - 1) * 2 + C, (gM + 1) ^ 4, fun m b hq hG ↦ ?_⟩
  have hq' : Nat.card (BaseExt k₁ D) ^ m = p ^ (2 * b) := by
    rw [Module.natCard_eq_pow_finrank (K := k), ← pow_mul]; exact hq
  have := hC m b hq' hG
  linear_combination this

/-- **The lower bound for `N_r`** (Nivedita, Theorem 3.10 with §3.2.4; Kedlaya, Lemma 5.1.9):
there are `d ≥ 1` and constants with `N_{dm} ≥ q^{dm} − A q^{dm/2} − C` whenever
`q^{dm} = p^{2b} > G₀`. -/
theorem exists_lower_bound (p : ℕ) [Fact p.Prime] [CharP k p] :
    ∃ d : ℕ, 0 < d ∧ ∃ A C G₀ : ℤ, ∀ m b : ℕ, Nat.card k ^ (d * m) = p ^ (2 * b) →
      G₀ < (p : ℤ) ^ (2 * b) → (p : ℤ) ^ (2 * b) - A * p ^ b - C ≤ pointCount k F (d * m) := by
  obtain ⟨x, hx, hsep⟩ := exists_separating k F
  have : FiniteDimensional k⟮x⟯ F := finiteDimensional_adjoin hx
  obtain ⟨y, hy⟩ := Field.exists_primitive_element k⟮x⟯ F
  set PF := (minpoly k⟮x⟯ y).map (algebraMap k⟮x⟯ F)
  exact exists_lower_bound_of_splitting p x hx y hy PF.SplittingField
    (SplittingField.splits PF) (SplittingField.adjoin_rootSet PF)

end Construction

end WeilCurves.FunctionField
