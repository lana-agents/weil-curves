import WeilCurves.Hurwitz.Local

/-!
# Ramification indices, the conormOf and the different divisor

For a finite separable extension `L / K` of function fields over a perfect field `k`:

* `ramIndex K Q = e(Q|P) = ord_Q π_P` for a fixed uniformiser `π_P = unif P` of `P = Q|_K`, so
  that `ord_Q x = e(Q|P) ord_P x` for `x ∈ K` (`ord_algebraMap_eq_ramIndex_mul`);
* the conormOf `Con_{L/K} A = ∑_Q e(Q|P) A(P) Q` (`conormOf`) with
  `deg Con_{L/K} A = [L : K] deg A` (`deg_conormOf`, from `∑_{Q|P} e(Q|P) deg Q = [L : K] deg P`,
  `deg_conormOf_single`);
* the different exponent `d(Q|P) = -ord_Q c_P ≥ 0` (`diffExp`, Stichtenoth §III.4: `C_P` is
  generated by `t` with `d(Q|P) = -ord_Q t`), which vanishes for almost all `Q`: for a
  primitive element `α` integral over `O_P`, `f'(α)` lies in Mathlib's `differentIdeal`
  (`aeval_derivative_mem_differentIdeal`), hence `d(Q|P) ≤ ord_Q f'(α)`;
* the different `Diff(L/K) = ∑_Q d(Q|P) Q` (`different`).
-/

open IsDedekindDomain Module Polynomial
open scoped IntermediateField

set_option linter.unusedSectionVars false

namespace WeilCurves.FunctionField

variable {k K : Type*} [Field k] [Field K] [Algebra k K] (L : Type*) [Field L] [Algebra K L]
  [Algebra k L] [IsScalarTower k K L] [PerfectField k] [IsFunctionField k K]
  [IsFunctionField k L] [FiniteDimensional K L]

/-- A fixed uniformiser of a place. -/
noncomputable def unifier (P : Place k K) : K := P.exists_ord_eq_one.choose

theorem ord_unifier (P : Place k K) : P.ord (unifier P) = 1 := P.exists_ord_eq_one.choose_spec

variable (K) {L} in
/-- The ramification index `e(Q|P) = ord_Q π_P`, `P = Q|_K`. -/
noncomputable def ramIndex (Q : Place k L) : ℤ :=
  Q.ord (algebraMap K L (unifier (Q.restrict (K := K))))

variable {L}

theorem ramIndex_pos (Q : Place k L) : 0 < ramIndex K Q :=
  Q.ord_algebraMap_uniformizer_pos (ord_unifier _)

/-- `ord_Q x = e(Q|P) ord_P x`. -/
theorem ord_algebraMap_eq_ramIndex_mul (Q : Place k L) (x : K) :
    Q.ord (algebraMap K L x) = ramIndex K Q * (Q.restrict (K := K)).ord x :=
  Q.ord_algebraMap_eq (ord_unifier _) x

theorem finite_setOf_restrict_mem (s : Set (Place k K)) (hs : s.Finite) :
    {Q : Place k L | Q.restrict (K := K) ∈ s}.Finite := by
  have : {Q : Place k L | Q.restrict (K := K) ∈ s} =
      ⋃ P ∈ s, {Q : Place k L | Q.restrict (K := K) = P} := by
    ext Q; simp
  rw [this]
  exact hs.biUnion fun P _ ↦ finite_setOf_restrict_eq P

/-! ### The conormOf -/

variable (L) in
/-- The conormOf `Con_{L/K} A = ∑_Q e(Q|P) A(Q|_K) Q`. -/
noncomputable def conormOf (A : Divisor k K) : Divisor k L :=
  Finsupp.ofSupportFinite (fun Q ↦ ramIndex K Q * A (Q.restrict (K := K)))
    ((finite_setOf_restrict_mem (L := L) _ A.support.finite_toSet).subset fun Q hQ ↦ by
      simp only [Function.mem_support, ne_eq] at hQ
      simp only [Set.mem_setOf_eq, Finset.mem_coe, Finsupp.mem_support_iff]
      exact right_ne_zero_of_mul hQ)

theorem conormOf_apply (A : Divisor k K) (Q : Place k L) :
    conormOf L A Q = ramIndex K Q * A (Q.restrict (K := K)) := rfl

theorem conormOf_add (A B : Divisor k K) : conormOf L (A + B) = conormOf L A + conormOf L B := by
  ext Q
  simp only [conormOf_apply, Finsupp.coe_add, Pi.add_apply]
  ring

theorem conormOf_zero : conormOf L (0 : Divisor k K) = 0 := by
  ext Q; simp [conormOf_apply]

variable (L) in
/-- The conormOf as an additive map. -/
noncomputable def conormOfHom : Divisor k K →+ Divisor k L where
  toFun := conormOf L
  map_zero' := conormOf_zero
  map_add' := conormOf_add

/-- **The fundamental equality**: `∑_{Q|P} e(Q|P) deg Q = [L : K] deg P`, in the form
`deg Con_{L/K} P = [L : K] deg P`. -/
theorem deg_conormOf_single (P : Place k K) :
    (conormOf L (Finsupp.single P 1)).deg = finrank K L * P.deg := by
  classical
  obtain ⟨x, hx, hxP, hxo⟩ := exists_zero_only_at P
  set m := P.ord x
  have : FiniteDimensional k⟮x⟯ K := finiteDimensional_adjoin hx
  have hzK : Divisor.zeroDivisor k x = Finsupp.single P m := by
    ext P'
    rw [Divisor.zeroDivisor_apply, Finsupp.single_apply]
    split_ifs with h
    · subst h; omega
    · have := hxo P' (Ne.symm h); omega
  have hdegK := Divisor.deg_zeroDivisor hx
  rw [hzK, Divisor.deg_single] at hdegK
  have hxL : Transcendental k (algebraMap K L x) :=
    (transcendental_algebraMap_iff (algebraMap K L).injective).mpr hx
  have hdegL := Divisor.deg_zeroDivisor (K := L) hxL
  rw [finrank_adjoin_algebraMap, Nat.cast_mul, ← hdegK] at hdegL
  have hzL : Divisor.zeroDivisor k (algebraMap K L x) = m • conormOf L (Finsupp.single P 1) := by
    ext Q
    rw [Divisor.zeroDivisor_apply, Finsupp.smul_apply, conormOf_apply, Finsupp.single_apply,
      ord_algebraMap_eq_ramIndex_mul, smul_eq_mul]
    have he := ramIndex_pos (K := K) Q
    split_ifs with h
    · rw [← h, max_eq_right (mul_nonneg he.le hxP.le)]; ring
    · have := hxo _ (Ne.symm h)
      rw [mul_zero, mul_zero]
      exact max_eq_left (mul_nonpos_of_nonneg_of_nonpos he.le this)
  rw [hzL, Divisor.deg_zsmul] at hdegL
  have hm : 0 < m := hxP
  have : m * (conormOf L (Finsupp.single P 1)).deg = m * (finrank K L * P.deg) := by
    rw [hdegL]; ring
  exact mul_left_cancel₀ hm.ne' this

/-- **`deg Con_{L/K} A = [L : K] deg A`**. -/
theorem deg_conormOf (A : Divisor k K) : (conormOf L A).deg = finrank K L * A.deg := by
  induction A using Finsupp.induction_linear with
  | zero => simp [conormOf_zero]
  | add A B hA hB => rw [conormOf_add, Divisor.deg_add, Divisor.deg_add, hA, hB]; ring
  | single P n =>
    have : Finsupp.single P n = n • Finsupp.single P (1 : ℤ) := by
      rw [Finsupp.smul_single, smul_eq_mul, mul_one]
    have h := map_zsmul (conormOfHom L) n (Finsupp.single P (1 : ℤ))
    change conormOf L (n • _) = n • conormOf L _ at h
    rw [this, h, Divisor.deg_zsmul, Divisor.deg_zsmul, deg_conormOf_single,
      Divisor.deg_single]; ring

/-! ### The different -/

section Different

variable [Algebra.IsSeparable K L]

variable (K) in
/-- The different exponent `d(Q|P) = -ord_Q c_P` (`C_P = c_P O'_P`, `P = Q|_K`). -/
noncomputable def diffExp (Q : Place k L) : ℤ := -Q.ord (codiffGen L (Q.restrict (K := K)))

theorem diffExp_nonneg (Q : Place k L) : 0 ≤ diffExp K Q := by
  have := ord_codiffGen_nonpos (L := L) (P := Q.restrict (K := K)) rfl
  rw [diffExp]; omega

/-- `d(Q|P) ≤ ord_Q f'(α)` for a primitive element `α ∈ O'_P` with minimal polynomial `f`. -/
theorem diffExp_le_ord_derivative {P : Place k K} {α : L} (hα : α ∈ intClo L P)
    (hgen : Algebra.adjoin K {α} = ⊤) {Q : Place k L} (hQ : Q.restrict (K := K) = P) :
    diffExp K Q ≤ Q.ord (aeval α (derivative (minpoly K α))) := by
  set S := intClo L P
  set x : S := ⟨α, hα⟩
  have hδ := aeval_derivative_mem_differentIdeal P.1 K L x hgen
  set δ : S := aeval x (derivative (minpoly P.1 x))
  have hint : IsIntegral P.1 x := IsIntegralClosure.isIntegral P.1 L x
  have hδL : algebraMap S L δ = aeval α (derivative (minpoly K α)) := by
    have hmin : minpoly K α = (minpoly P.1 x).map (algebraMap P.1 K) :=
      minpoly.isIntegrallyClosed_eq_field_fractions K L hint
    rw [hmin, derivative_map, aeval_map_algebraMap]
    exact (aeval_algebraMap_apply L x _).symm
  have hsep : (minpoly K α).Separable := Algebra.IsSeparable.isSeparable K α
  have hδ0 : aeval α (derivative (minpoly K α)) ≠ 0 :=
    hsep.aeval_derivative_ne_zero (minpoly.aeval K α)
  -- `c_P δ ∈ O'_P`
  set I := FractionalIdeal.dual P.1 K (1 : FractionalIdeal (nonZeroDivisors S) L)
  have hI : I ≠ 0 := FractionalIdeal.dual_ne_zero _ _ one_ne_zero
  have hcI : codiffGen L P ∈ I :=
    isCodiff_iff_mem_dual.mp (isCodiff_iff.mpr ⟨1, S.one_mem, (mul_one _).symm⟩)
  have hδI : algebraMap S L δ ∈ I⁻¹ := by
    rw [← coeIdeal_differentIdeal P.1 K L]
    exact FractionalIdeal.mem_coeIdeal_of_mem _ hδ
  have hmul : codiffGen L P * algebraMap S L δ ∈ (1 : FractionalIdeal (nonZeroDivisors S) L) := by
    rw [← mul_inv_cancel₀ hI]
    exact FractionalIdeal.mul_mem_mul hcI hδI
  obtain ⟨s, hs⟩ := (FractionalIdeal.mem_one_iff _).mp hmul
  have hmem : codiffGen L P * aeval α (derivative (minpoly K α)) ∈ Q.1 := by
    rw [← hδL, ← hs]; exact mem_of_mem_intClo hQ s.2
  have := Q.ord_nonneg_of_mem hmem
  rw [Q.ord_mul codiffGen_ne_zero hδ0] at this
  rw [diffExp, hQ]
  omega

theorem isIntegral_of_coeff_mem {P : Place k K} {α : L}
    (h : ∀ i, (minpoly K α).coeff i ∈ P.1) : α ∈ intClo L P := by
  have hlift : (minpoly K α) ∈ Polynomial.lifts (algebraMap P.1 K) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    exact ⟨⟨_, h i⟩, rfl⟩
  have hmon : (minpoly K α).Monic := minpoly.monic (Algebra.IsIntegral.isIntegral α)
  obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hmon
  refine ⟨q, hqm, ?_⟩
  rw [IsScalarTower.algebraMap_eq P.1 K L, ← Polynomial.eval₂_map, hq]
  exact minpoly.aeval K α

variable (K L) in
theorem finite_setOf_diffExp_ne_zero : {Q : Place k L | diffExp K Q ≠ 0}.Finite := by
  classical
  obtain ⟨α, hα⟩ := Field.exists_primitive_element K L
  have hgen : Algebra.adjoin K {α} = ⊤ := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (Algebra.IsIntegral.isIntegral α).isAlgebraic, hα, IntermediateField.top_toSubalgebra]
  set f := minpoly K α
  set bad : Set (Place k K) := ⋃ i ∈ f.support, {P | f.coeff i ∉ P.1}
  have hbad : bad.Finite :=
    f.support.finite_toSet.biUnion fun i _ ↦ Place.finite_setOf_notMem _
  set δ := aeval α (derivative f)
  refine ((finite_setOf_restrict_mem (L := L) bad hbad).union
    (Place.finite_setOf_ord_pos δ)).subset fun Q hQ ↦ ?_
  simp only [Set.mem_setOf_eq] at hQ
  by_cases hQb : Q.restrict (K := K) ∈ bad
  · exact Or.inl hQb
  refine Or.inr ?_
  have hcoeff : ∀ i, f.coeff i ∈ (Q.restrict (K := K)).1 := by
    intro i
    by_cases hi : i ∈ f.support
    · by_contra hn
      exact hQb (Set.mem_biUnion hi hn)
    · rw [Polynomial.notMem_support_iff.mp hi]; exact Subring.zero_mem _
  have hle := diffExp_le_ord_derivative (isIntegral_of_coeff_mem hcoeff) hgen rfl
  have := diffExp_nonneg (K := K) Q
  have hδ : Q.ord δ = Q.ord (aeval α (derivative (minpoly K α))) := rfl
  change 0 < Q.ord δ
  omega

variable (k K L) in
/-- The different `Diff(L/K) = ∑_Q d(Q|P) Q`. -/
noncomputable def different : Divisor k L :=
  Finsupp.ofSupportFinite (fun Q : Place k L ↦ diffExp K Q) (finite_setOf_diffExp_ne_zero K L)

theorem different_apply (Q : Place k L) : different k K L Q = diffExp K Q := rfl

theorem different_nonneg : 0 ≤ different k K L := fun Q ↦ diffExp_nonneg Q

end Different

end WeilCurves.FunctionField
