import WeilCurves.Hurwitz.Main

/-!
# Dedekind's different theorem in characteristic zero

For a finite separable extension `L / K` of function fields over a perfect field `k`, the
different exponent satisfies `d(Q|P) ≥ e(Q|P) - 1`, with equality if `char k ∤ e(Q|P)`
(Dedekind's different theorem; Stichtenoth, Theorem 3.5.1; statement as quoted in Chen–Hu,
arXiv:2603.23930, Thm. 2.2). We prove the equality when `k` has characteristic zero
(`diffExp_eq_of_charZero`), via Mathlib's different ideal of `O'_P` over `O_P`:

* `𝔮^{e-1} ∣ 𝔇` (`pow_sub_one_dvd_differentIdeal_aux`), and
* `𝔮^e ∤ 𝔇` (`not_dvd_differentIdeal_of_intTrace_not_mem`): with `𝔭 O'_P = 𝔮^e J`,
  `J` coprime to `𝔮`, an `x ≡ 1 (mod 𝔮^e)`, `x ∈ J` has
  `Tr x ≡ dim_{κ(P)} O'_P/𝔮^e ≠ 0 (mod 𝔭)` in characteristic zero,

and `ord_Q` of a generator of `𝔇` is `d(Q|P)`. Consequently
`Diff(L/K) = ∑_Q (e(Q|P) - 1) Q` (`different_eq_ramification`) and the **Riemann–Hurwitz
formula** `2 g_L - 2 = [L : K] (2 g_K - 2) + ∑_Q (e(Q|P) - 1) deg Q`
(`riemannHurwitz_charZero`).
-/

open IsDedekindDomain Module

set_option linter.unusedSectionVars false

namespace WeilCurves.FunctionField

variable {k K : Type*} [Field k] [Field K] [Algebra k K] {L : Type*} [Field L] [Algebra K L]
  [Algebra k L] [IsScalarTower k K L] [PerfectField k] [IsFunctionField k K]
  [IsFunctionField k L] [FiniteDimensional K L] [Algebra.IsSeparable K L]

variable {P : Place k K}

/-- `r ∈ 𝔮^m ↔ ord_Q r ≥ m` for the prime `𝔮` of `O'_P` below `Q`. -/
theorem mem_toPrime_pow_iff {Q : Place k L} (hQ : Q.restrict (K := K) = P)
    {r : intClo L P} (hr : r ≠ 0) (m : ℕ) :
    r ∈ (toPrime hQ).asIdeal ^ m ↔ (m : ℤ) ≤ Q.ord (r : L) := by
  rw [← HeightOneSpectrum.intValuation_le_pow_iff_mem]
  have hord : Q.ord (r : L) = -WithZero.log ((toPrime hQ).intValuation r) := by
    conv_lhs => rw [← placeOfPrime_toPrime hQ]
    rw [ord_placeOfPrime]
    change -WithZero.log ((toPrime hQ).valuation L (algebraMap _ L r)) = _
    rw [HeightOneSpectrum.valuation_of_algebraMap]
  have hne : (toPrime hQ).intValuation r ≠ 0 := (toPrime hQ).intValuation_ne_zero r hr
  rw [hord, ← WithZero.exp_log hne, WithZero.log_exp, WithZero.exp_le_exp]
  omega

theorem dvd_span_iff {Q : Place k L} (hQ : Q.restrict (K := K) = P)
    {r : intClo L P} (hr : r ≠ 0) (m : ℕ) :
    (toPrime hQ).asIdeal ^ m ∣ Ideal.span {r} ↔ (m : ℤ) ≤ Q.ord (r : L) := by
  rw [Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem, mem_toPrime_pow_iff hQ hr]

/-- The maximal ideal of `O_P` is generated by a uniformiser. -/
theorem maximalIdeal_eq_span_unifier :
    IsLocalRing.maximalIdeal P.1 =
      Ideal.span {(⟨unifier P, P.mem_of_ord_nonneg (by rw [ord_unifier]; omega)⟩ : P.1)} := by
  set π : P.1 := ⟨unifier P, P.mem_of_ord_nonneg (by rw [ord_unifier]; omega)⟩
  have hπ0 : (π : K) ≠ 0 := by
    intro h; have := ord_unifier P; rw [show unifier P = (π : K) from rfl, h, P.ord_zero] at this
    omega
  ext x
  rw [Ideal.mem_span_singleton]
  constructor
  · intro hx
    by_cases hx0 : (x : K) = 0
    · exact ⟨0, Subtype.ext (by simp [hx0])⟩
    have hpos : 0 < P.ord x := (P.ord_pos_iff).mpr ⟨hx0, by
      rw [ValuationSubring.coe_mem_nonunits_iff]; exact hx⟩
    have hmem : (x : K) / π ∈ P.1 := P.mem_of_ord_nonneg (by
      rw [P.ord_div hx0 hπ0, show (π : K) = unifier P from rfl, ord_unifier]; omega)
    exact ⟨⟨_, hmem⟩, Subtype.ext (by simp [mul_div_cancel₀ _ hπ0])⟩
  · rintro ⟨y, rfl⟩
    refine Ideal.mul_mem_right _ _ ?_
    rw [← ValuationSubring.coe_mem_nonunits_iff]
    exact ((P.ord_pos_iff).mp (by rw [show (π : K) = unifier P from rfl, ord_unifier]; omega)).2


/-- `ord_Q` of a generator of Mathlib's different ideal of `O'_P / O_P` is `d(Q|P)`. -/
theorem ord_differentIdeal_gen {Q : Place k L} (hQ : Q.restrict (K := K) = P) {r : intClo L P}
    (hr : differentIdeal P.1 (intClo L P) = Ideal.span {r}) :
    r ≠ 0 ∧ Q.ord (r : L) = -Q.ord (codiffGen L P) := by
  set c := codiffGen L P
  have hc : c ≠ 0 := codiffGen_ne_zero
  have hdual : FractionalIdeal.dual P.1 K
      (1 : FractionalIdeal (nonZeroDivisors (intClo L P)) L) =
      FractionalIdeal.spanSingleton (nonZeroDivisors (intClo L P)) c := by
    ext z
    rw [FractionalIdeal.mem_spanSingleton, ← isCodiff_iff_mem_dual, isCodiff_iff]
    constructor
    · rintro ⟨s, hs, rfl⟩
      exact ⟨⟨s, hs⟩, by rw [Algebra.smul_def, mul_comm]; rfl⟩
    · rintro ⟨s, rfl⟩
      exact ⟨s, s.2, by rw [Algebra.smul_def, mul_comm]; rfl⟩
  have hD : ((differentIdeal P.1 (intClo L P) : Ideal (intClo L P)) :
      FractionalIdeal (nonZeroDivisors (intClo L P)) L) =
      FractionalIdeal.spanSingleton (nonZeroDivisors (intClo L P)) c⁻¹ := by
    rw [coeIdeal_differentIdeal P.1 K L, hdual, FractionalIdeal.spanSingleton_inv]
  rw [hr, FractionalIdeal.coeIdeal_span_singleton,
    FractionalIdeal.spanSingleton_eq_spanSingleton] at hD
  obtain ⟨u, hu⟩ := hD
  have hu' : ((u : intClo L P) : L) * (r : L) = c⁻¹ := by
    rw [← hu, Units.smul_def, Algebra.smul_def]; rfl
  have hr0 : r ≠ 0 := by
    rintro rfl
    rw [ZeroMemClass.coe_zero, mul_zero] at hu'
    exact inv_ne_zero hc hu'.symm
  have hrL : (r : L) ≠ 0 := fun h ↦ hr0 (Subtype.ext h)
  have huL : ((u : intClo L P) : L) ≠ 0 := fun h ↦ u.ne_zero (Subtype.ext h)
  have hu0 : Q.ord ((u : intClo L P) : L) = 0 := by
    refine (Q.ord_eq_zero_iff huL).mpr ⟨mem_of_mem_intClo hQ (u : intClo L P).2, ?_⟩
    have : ((u : intClo L P) : L)⁻¹ = (((u⁻¹ : (intClo L P)ˣ) : intClo L P) : L) := by
      rw [eq_comm, ← mul_eq_one_iff_eq_inv₀ huL, ← MulMemClass.coe_mul, Units.inv_mul]; rfl
    rw [this]; exact mem_of_mem_intClo hQ (((u⁻¹ : (intClo L P)ˣ) : intClo L P)).2
  refine ⟨hr0, ?_⟩
  have := congrArg Q.ord hu'
  rw [Q.ord_mul huL hrL, Q.ord_inv, hu0] at this
  omega

attribute [local instance] Ideal.Quotient.field FractionRing.liftAlgebra
  FractionRing.isScalarTower_liftAlgebra

set_option maxHeartbeats 1000000 in
-- the trace computation unfolds the quotient algebra structures
/-- **Dedekind's different theorem in characteristic zero**: `d(Q|P) = e(Q|P) - 1`. -/
theorem diffExp_eq_of_charZero [CharZero k] (Q : Place k L) :
    diffExp K Q = ramIndex K Q - 1 := by
  classical
  set P := Q.restrict (K := K) with hPdef
  have hQ : Q.restrict (K := K) = P := rfl
  set B := intClo L P
  set 𝔮 := (toPrime hQ).asIdeal
  set p := IsLocalRing.maximalIdeal P.1
  have hepos : 0 < ramIndex K Q := ramIndex_pos Q
  set e := (ramIndex K Q).toNat
  have he' : (e : ℤ) = ramIndex K Q := Int.toNat_of_nonneg hepos.le
  have he0 : e ≠ 0 := by omega
  set π : P.1 := ⟨unifier P, P.mem_of_ord_nonneg (by rw [ord_unifier]; omega)⟩
  have hp : p = Ideal.span {π} := maximalIdeal_eq_span_unifier
  set πB : B := algebraMap P.1 B π
  have hπB : (πB : L) = algebraMap K L (unifier P) := algebraMap_place_apply P π
  have hπ0 : unifier P ≠ 0 := by
    intro h; have := ord_unifier P; rw [h, P.ord_zero] at this; omega
  have hπB0 : πB ≠ 0 := by
    intro h
    apply hπ0
    have : (πB : L) = 0 := by rw [h]; rfl
    rw [hπB] at this
    exact (map_eq_zero _).mp this
  have hordπ : Q.ord (πB : L) = ramIndex K Q := by rw [hπB]; rfl
  have hpB : p.map (algebraMap P.1 B) = Ideal.span {πB} := by
    rw [hp, Ideal.map_span, Set.image_singleton]
  have hdvd : 𝔮 ^ e ∣ p.map (algebraMap P.1 B) := by
    rw [hpB, dvd_span_iff hQ hπB0]; omega
  have hndvd : ¬ 𝔮 ^ (e + 1) ∣ p.map (algebraMap P.1 B) := by
    rw [hpB, dvd_span_iff hQ hπB0]; push_cast; omega
  have hp0 : p ≠ ⊥ := by
    rw [hp]; intro h
    rw [Ideal.span_singleton_eq_bot] at h
    exact hπ0 (congrArg Subtype.val h)
  -- the different ideal is principal
  obtain ⟨r, hr⟩ := (Submodule.IsPrincipal.principal (differentIdeal P.1 B) :
    ∃ r, differentIdeal P.1 B = Submodule.span B {r})
  obtain ⟨hr0, hrord⟩ := ord_differentIdeal_gen hQ (r := r) hr
  -- lower bound
  have hlow : 𝔮 ^ (e - 1) ∣ differentIdeal P.1 B :=
    pow_sub_one_dvd_differentIdeal_aux P.1 K L 𝔮 he0 hp0 hdvd
  rw [hr, dvd_span_iff hQ hr0] at hlow
  -- upper bound
  obtain ⟨J, hJ⟩ := hdvd
  have hcop : 𝔮 ⊔ J = ⊤ := by
    by_contra h
    have hle : J ≤ 𝔮 :=
      le_sup_right.trans ((toPrime hQ).isMaximal.eq_of_le h le_sup_left).ge
    apply hndvd
    rw [hJ, pow_succ]
    exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
  have hcop' : IsCoprime (𝔮 ^ e) J := (Ideal.isCoprime_iff_sup_eq.mpr hcop).pow_left
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp
    (show (1 : B) ∈ 𝔮 ^ e ⊔ J by rw [Ideal.isCoprime_iff_sup_eq.mp hcop']; trivial)
  have htr : Algebra.intTrace P.1 B b ∉ p := by
    letI : Algebra (P.1 ⧸ p) (B ⧸ J) := Ideal.Quotient.algebraQuotientOfLEComap (by
      rw [← Ideal.map_le_iff_le_comap, hJ]; exact Ideal.mul_le_left)
    letI : Algebra (P.1 ⧸ p) (B ⧸ 𝔮 ^ e) := Ideal.Quotient.algebraQuotientOfLEComap (by
      rw [← Ideal.map_le_iff_le_comap, hJ]; exact Ideal.mul_le_right)
    have : IsScalarTower P.1 (P.1 ⧸ p) (B ⧸ J) := .of_algebraMap_eq' rfl
    have : IsScalarTower P.1 (P.1 ⧸ p) (B ⧸ 𝔮 ^ e) := .of_algebraMap_eq' rfl
    have : Module.Finite (P.1 ⧸ p) (B ⧸ J) :=
      Module.Finite.of_restrictScalars_finite P.1 (P.1 ⧸ p) (B ⧸ J)
    have : Module.Finite (P.1 ⧸ p) (B ⧸ 𝔮 ^ e) :=
      Module.Finite.of_restrictScalars_finite P.1 (P.1 ⧸ p) (B ⧸ 𝔮 ^ e)
    let eqv : (B ⧸ p.map (algebraMap P.1 B)) ≃ₐ[P.1 ⧸ p] ((B ⧸ 𝔮 ^ e) × B ⧸ J) :=
      { __ := (Ideal.quotEquivOfEq hJ).trans (Ideal.quotientMulEquivQuotientProd _ _ hcop'),
        commutes' := Quotient.ind fun _ ↦ rfl }
    have h1 : (eqv (Ideal.Quotient.mk _ b)).1 = 1 := by
      change Ideal.Quotient.mk (𝔮 ^ e) b = 1
      rw [← map_one (Ideal.Quotient.mk (𝔮 ^ e)), Ideal.Quotient.eq]
      have : b - 1 = -a := by rw [← hab]; ring
      rw [this]; exact (𝔮 ^ e).neg_mem ha
    have h2 : (eqv (Ideal.Quotient.mk _ b)).2 = 0 := by
      change Ideal.Quotient.mk J b = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]; exact hb
    have hne : (𝔮 ^ e) ≠ ⊤ := fun h ↦ (toPrime hQ).isMaximal.ne_top
      (top_le_iff.mp (h ▸ Ideal.pow_le_self he0))
    have : Nontrivial (B ⧸ 𝔮 ^ e) := Ideal.Quotient.nontrivial_iff.mpr hne
    have hchar : CharZero (P.1 ⧸ p) :=
      charZero_of_injective_ringHom ((Ideal.Quotient.mk p).comp P.baseHom).injective
    have e1 := Algebra.trace_quotient_eq_of_isDedekindDomain (p := p) (S := B) b
    have e2 := Algebra.trace_eq_of_algEquiv eqv (Ideal.Quotient.mk (p.map (algebraMap P.1 B)) b)
    have e3 := Algebra.trace_prod_apply (R := P.1 ⧸ p) (eqv (Ideal.Quotient.mk _ b))
    rw [h1, h2, map_zero, add_zero, ← map_one (algebraMap (P.1 ⧸ p) (B ⧸ 𝔮 ^ e)),
      Algebra.trace_algebraMap, nsmul_one] at e3
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← e1, ← e2, e3]
    exact Nat.cast_ne_zero.mpr Module.finrank_pos.ne'
  -- separability over the fraction rings, for Mathlib's lemma
  have H : RingHom.comp (algebraMap (FractionRing P.1) (FractionRing B))
      ↑(FractionRing.algEquiv P.1 K).symm.toRingEquiv =
        RingHom.comp ↑(FractionRing.algEquiv B L).symm.toRingEquiv (algebraMap K L) := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors P.1)
    ext
    simp only [RingHom.coe_comp, RingHom.coe_coe, AlgEquiv.coe_ringEquiv, Function.comp_apply,
      AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply]
    rw [IsScalarTower.algebraMap_apply P.1 B L, AlgEquiv.commutes,
      ← IsScalarTower.algebraMap_apply]
  have : Algebra.IsSeparable (FractionRing P.1) (FractionRing B) :=
    Algebra.IsSeparable.of_equiv_equiv _ _ H
  have hup := not_dvd_differentIdeal_of_intTrace_not_mem P.1 (𝔮 ^ e) J hJ.symm b hb htr
  rw [hr, dvd_span_iff hQ hr0] at hup
  rw [diffExp, ← hrord]
  omega

/-- In characteristic zero, `Diff(L/K) = ∑_Q (e(Q|P) - 1) Q`. -/
theorem different_apply_of_charZero [CharZero k] (Q : Place k L) :
    different k K L Q = ramIndex K Q - 1 :=
  diffExp_eq_of_charZero Q

/-- **The Riemann–Hurwitz formula in characteristic zero**:
`2 g_L - 2 = [L : K] (2 g_K - 2) + ∑_Q (e(Q|P) - 1) deg Q`, the sum running over any finite set
of places containing the ramified ones. -/
theorem riemannHurwitz_charZero [CharZero k] (S : Finset (Place k L))
    (hS : ∀ Q : Place k L, Q ∉ S → ramIndex K Q = 1) :
    2 * genus k L - 2 = finrank K L * (2 * genus k K - 2) +
      ∑ Q ∈ S, (ramIndex K Q - 1) * (Q.deg : ℤ) := by
  rw [riemannHurwitz (K := K), Divisor.deg_eq_sum_of_support_subset (different k K L)
    (s := S) ?_]
  · simp only [different_apply_of_charZero]
  · intro Q hQ
    by_contra hQS
    rw [Finsupp.mem_support_iff, different_apply_of_charZero, hS Q hQS, sub_self] at hQ
    exact hQ rfl

end WeilCurves.FunctionField
